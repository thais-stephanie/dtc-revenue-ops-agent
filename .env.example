# Model
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
INPUT_USD_PER_MTOK=3.00
OUTPUT_USD_PER_MTOK=15.00

# Demo clock: the dataset is generated relative to this instant, so the demo
# is reproducible and does not rot.
DEMO_AS_OF=2026-09-22T09:00:00+00:00
DEMO_SEED=42

# Optional Postgres mirror
DATABASE_URL=postgresql://revenue:revenue@localhost:5432/revenue

# Read-only integration lab (optional; see docs/REAL_INTEGRATIONS.md).
# Read-only tokens only. Leave blank: "NOT CONFIGURED" is a normal state.
HUBSPOT_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
KLAVIYO_PRIVATE_API_KEY=
